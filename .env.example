# ─────────────────────────────────────────────────────────────────────────────
# Personal AI Companion — environment template. Copy to .env and fill in.
# NEVER commit .env. Generate secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Companion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://companion.example.com
APP_TIMEZONE=UTC            # keep UTC: all instants are stored as UTC; user timezones are per-user

# Public hostname served by the Caddy proxy (DNS A/AAAA → your VPS) + ACME contact
APP_DOMAIN=companion.example.com
ACME_EMAIL=you@example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── Database (PostgreSQL 17 + pgvector) ─────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=companion
DB_USERNAME=companion
DB_PASSWORD=
# Separate role/database used only by the Mem0 sidecar (created by docker/postgres/init)
MEM0_PG_PASSWORD=

# ── Redis (queues, cache, locks) ────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 16–256 chars of [A-Za-z0-9_-]; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_VOICE_BYTES=10485760
TELEGRAM_MAX_VOICE_SECONDS=600

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Set to currently supported model IDs from https://platform.openai.com/docs/models
# (chat model must support function calling with strict schemas + json_schema outputs).
OPENAI_CHAT_MODEL=
OPENAI_UTILITY_MODEL=
# Speech-to-text model for voice notes (e.g. a current "*-transcribe" model or whisper-1)
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_MAX_COMPLETION_TOKENS=1200
# Leave empty for models that reject temperature (many reasoning models do)
OPENAI_TEMPERATURE=
# Pricing used ONLY for cost estimates/budgets — set to your model's real prices (USD / 1M tokens)
OPENAI_PRICE_INPUT_PER_MILLION=0.25
OPENAI_PRICE_OUTPUT_PER_MILLION=2.00
OPENAI_PRICE_TRANSCRIPTION_PER_MINUTE=0.006

# ── Agent limits & budgets ──────────────────────────────────────────────────
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_TOOL_CALLS_PER_RUN=12
AGENT_MAX_RUNTIME_SECONDS=90
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_DAILY_BUDGET_USD=2.00
AGENT_INBOUND_RATE_PER_MINUTE=20

# ── Memory (Mem0 sidecar) ───────────────────────────────────────────────────
MEMORY_DRIVER=mem0          # mem0 | null (null = structured-only degraded mode)
MEM0_BASE_URL=http://mem0:8000
# Shared secret between Laravel and the sidecar (>= 24 chars)
MEM0_API_KEY=
MEM0_USER_PREFIX=companion
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMS=1536
# 1 = deterministic fake embeddings for contract tests ONLY. Must be 0 in production.
MEM0_TEST_EMBEDDER=0

# ── Proactive behavior defaults (users change these by chatting) ────────────
COMPANION_DEFAULT_TIMEZONE=Europe/Paris
COMPANION_MORNING_TIME=09:00
COMPANION_EVENING_TIME=20:00
COMPANION_QUIET_START=22:00
COMPANION_QUIET_END=08:00
COMPANION_MAX_CHECKINS_PER_DAY=4
COMPANION_MIN_GAP_MINUTES=90
PROACTIVE_ENABLED=true

# ── Operations ──────────────────────────────────────────────────────────────
# Bearer token for GET /api/health (detailed readiness). Not exposed by the proxy.
HEALTH_TOKEN=
RETENTION_MESSAGES_DAYS=365
RETENTION_AGENT_RUNS_DAYS=90
RETENTION_NOTIFICATION_LOG_DAYS=90
